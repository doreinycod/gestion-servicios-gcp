# Servidor
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES=30m

# SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=GestionMultiservicios
DB_USER=sa
DB_PASSWORD=

# Facturación electrónica DGII: "simulado" hasta tener el certificado digital
DGII_MODO=simulado

# PayPal (Orders API v2). Sin credenciales funciona en modo simulado.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
TASA_USD=61

# Asistente IA (Claude). Sin clave usa respuestas por palabras clave.
ANTHROPIC_API_KEY=

# Proveedor de facturación electrónica (e-CF)
ECF_API_URL=
ECF_API_KEY=

# Asistente virtual con Gemini (Google). Sin clave usa Claude (ANTHROPIC_API_KEY) o respuestas por palabras clave.
GEMINI_API_KEY=
GEMINI_MODELO=

# Correo (SMTP) para "¿Olvidaste tu contraseña?". Sin esto, el enlace se muestra en la consola y en la pantalla (solo en desarrollo).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una "contraseña de aplicación" en SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Directorio Servicios <no-responder@directorioservicios.do>"
